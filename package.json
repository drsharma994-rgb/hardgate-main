{
  "name": "hardgate-main",
  "version": "1.0.0",
  "private": true,
  "description": "HARDGATE crypto + gold trading terminal — static app + same-origin API (proxy, book, TradeOS MCP)",
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ccxt": "^4.5.71",
    "puppeteer": "^25.8.0"
  },
  "optionalDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  },
  "scripts": {
    "start": "node scripts/server.mjs",
    "daemon": "node app.js",
    "check:prod": "node scripts/check-production.mjs",
    "sync:backtest-params": "node scripts/sync-backtest-tab-params.mjs",
    "test:data-layer": "node tests/test-data-layer.mjs",
    "og:walk": "node scripts/backtest-omnigold.mjs",
    "p80:walk": "node scripts/walk-80percent.mjs",
    "og:sweep": "node scripts/backtest-omnigold.mjs && node scripts/target-sweep.mjs",
    "og:bake": "node scripts/omnigold-evidence-bake.mjs --write",
    "og:resolve-1m": "node scripts/resolve-unprovable-1m.mjs",
    "og:audit": "node scripts/geometry-audit.mjs",
    "og:multi": "node scripts/backtest-multi.mjs --run --symbols=PAXGUSDT,XAUTUSDT",
    "test": "node scripts/run-tests.mjs",
    "gold:rebake": "node scripts/backtest-goldscalp.mjs && node scripts/backtest-goldswing.mjs && node scripts/backtest-omnigold.mjs && node scripts/omnigold-evidence-bake.mjs --write && node scripts/rebake-gold-literals.mjs --write && node scripts/gold-sibling-records.mjs --write && npm test",
    "gold:siblings": "node scripts/gold-sibling-records.mjs",
    "og:selection": "node scripts/mechanic-selection.mjs",
    "gold:milli": "node scripts/milli-gold-roster.mjs",
    "gold:milli-walk": "node scripts/milli-gold-walk.mjs",
    "gold:literals": "node scripts/rebake-gold-literals.mjs"
  }
}
